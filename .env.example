# Google Maps Platform API key for traffic-aware drive times.
#
# Used server-side only, by the /api/drivetimes serverless function
# (Distance Matrix API). It is never exposed to the browser.
#
# Production (Vercel): set this in
#   Project → Settings → Environment Variables  (add to all environments),
#   then redeploy.
#
# Local testing: copy this file to `.env` and run `vercel dev` (plain
# `vite dev` does not run the /api function).
GOOGLE_MAPS_API_KEY=
